# Copy to .env (never commit real keys)

# LLM — leave empty to keep the deterministic mock provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_TOKEN=
GITHUB_API_URL=https://api.github.com

# Process
LINEJUDGE_ADDR=:8080
LINEJUDGE_DB=data/linejudge.db
LINEJUDGE_FIXTURES=fixtures
LINEJUDGE_ROLE=all
LINEJUDGE_LLM_PROVIDER=mock
